# =============================================================================
# Sky Moon Scope — Docker Compose Configuration
# =============================================================================
# Copy this file to .env in the root directory to configure docker-compose.
# This file should be committed to version control (it's safe; it contains no secrets).
# The actual .env file is git-ignored and should NOT be committed.
# =============================================================================

# PostgreSQL password for docker-compose deployments.
# IMPORTANT: For production, generate a strong random password:
#   openssl rand -base64 32
# For development, you can use a simple value, but NEVER use trivially guessable
# defaults like 'postgres' in shared development environments.
# WARNING: This should NEVER be committed to version control for production!
POSTGRES_PASSWORD=your_secure_password_here
