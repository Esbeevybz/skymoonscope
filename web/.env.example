# Base URL of the Sky Moon Scope analyzer backend.
# Local dev defaults to this if unset; in production set it to the deployed backend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional demo contract data. JSON values must follow the shapes in
# lib/sorobantypes.ts. These NEXT_PUBLIC_ values are embedded at build time.
# NEXT_PUBLIC_CONTRACT_ID=C...
# NEXT_PUBLIC_CONTRACT_FUNCTIONS=[{"name":"balance","inputs":[{"name":"account","type":"address"}],"outputs":"u128"}]
# NEXT_PUBLIC_CONTRACT_MOCK_RESULTS={"balance":12345,"symbol":"MOCK"}
# NEXT_PUBLIC_CONTRACT_MOCK_TRANSACTIONS=[{"hash":"tx-1","functionName":"balance","status":"success","timestamp":1720000000000,"contractId":"C...","fee":"0.001"}]